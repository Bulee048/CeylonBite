# Backend environment template. Copy to `.env` and adjust for your machine.
# IMPORTANT: Use the least-privilege application login created by
# `backend/database/create-app-login.sql`, NOT the `sa` admin account.

# Express server port
PORT=5001

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CeylonBiteDB
DB_USER=CeylonBiteAppUser
DB_PASSWORD=replace-with-your-app-user-password

# JWT signing secret (change in production)
JWT_SECRET=replace-with-a-long-random-secret